# PessoasAqui Backend — Variáveis de Ambiente

# Porta do servidor (Render define automaticamente em produção)
PORT=3000

# Ambiente de execução
NODE_ENV=development

# String de Conexão com o Supabase (PostgreSQL)
# Obtenha em: Supabase -> Project Settings -> Database -> Connection string (URI)
# Se deixado em branco, o servidor utilizará o motor local em memória para testes imediatos.
DATABASE_URL=

# Produção: quando DATABASE_URL está configurada, uma falha no PostgreSQL
# bloqueia autenticação e gravações; nunca recua silenciosamente para RAM.
# PostgreSQL remoto deve apresentar certificado TLS válido.
# Se houver CA privada, fornecer PEM como variável segura no Render.
# PG_SSL_CA_PEM=

# Administrador: SEM credenciais padrão; todas obrigatórias para ativar painel.
# Não escrever senhas ou segredos reais em arquivos versionados.
# ADMIN_USER=
# ADMIN_PASSWORD=          (12 caracteres ou mais)
# ADMIN_JWT_SECRET=        (32 bytes ou mais, aleatórios)
