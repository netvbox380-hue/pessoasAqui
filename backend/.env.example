# PessoasAqui Backend — Variáveis de Ambiente

# Porta do servidor (Render define automaticamente em produção)
PORT=3000

# Ambiente de execução
NODE_ENV=development

# String de Conexão com o Supabase (PostgreSQL)
# Obtenha em: Supabase -> Project Settings -> Database -> Connection string (URI)
# Se deixado em branco, o servidor utilizará o motor local em memória para testes imediatos.
DATABASE_URL=
